+package com.genymobile.scrcpy.ws;
+
+import com.genymobile.scrcpy.device.Device;
+import com.genymobile.scrcpy.model.Size;
+
+import android.graphics.Rect;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Objects;
+
+/**
+ * Stream parameters requested by a ws-scrcpy client (binary layout shared with src/app/VideoSettings.ts).
+ *
+ * <pre>
+ * bitRate          int32
+ * maxFps           int32
+ * iFrameInterval   int8
+ * bounds           uint16 width, uint16 height (0: no limit)
+ * crop             int16 left, top, right, bottom (all 0: no crop)
+ * sendFrameMeta    int8 (ignored)
+ * lockedVideoOrientation int8 (-1: unlocked)
+ * displayId        int32 (-1: create a new virtual display)
+ * codecOptions     int32 length + utf8
+ * encoderName      int32 length + utf8
+ * newDisplay       uint16 width, uint16 height, uint16 dpi (optional, 0: same as the main display)
+ * flags            uint8 (optional): 1 = keep the device active, 2 = flex display (resized by the client)
+ * startApp         int32 length + utf8 (optional): package of the app to start on a new virtual display
+ * </pre>
+ */
+public final class WsVideoSettings {
+
+    private static final int BASE_LENGTH = 35;
+    private static final int NEW_DISPLAY_LENGTH = 6;
+    private static final int FLAGS_LENGTH = 1;
+
+    public static final int FLAG_KEEP_ACTIVE = 1;
+    public static final int FLAG_FLEX_DISPLAY = 1 << 1;
+
+    private int bitRate = 8000000;
+    private int maxFps;
+    private byte iFrameInterval = 10;
+    private int boundsWidth;
+    private int boundsHeight;
+    private Rect crop;
+    private boolean sendFrameMeta;
+    private int lockedVideoOrientation = -1;
+    private int displayId;
+    private String codecOptions;
+    private String encoderName;
+    private int newDisplayWidth;
+    private int newDisplayHeight;
+    private int newDisplayDpi;
+    private int flags;
+    private String startApp;
+
+    public static WsVideoSettings fromBuffer(ByteBuffer data) {
+        WsVideoSettings s = new WsVideoSettings();
+        s.bitRate = data.getInt();
+        s.maxFps = data.getInt();
+        s.iFrameInterval = data.get();
+        s.boundsWidth = data.getShort() & 0xffff;
+        s.boundsHeight = data.getShort() & 0xffff;
+        int left = data.getShort();
+        int top = data.getShort();
+        int right = data.getShort();
+        int bottom = data.getShort();
+        if (left != 0 || top != 0 || right != 0 || bottom != 0) {
+            s.crop = new Rect(left, top, right, bottom);
+        }
+        s.sendFrameMeta = data.get() != 0;
+        s.lockedVideoOrientation = data.get();
+        s.displayId = data.getInt();
+        s.codecOptions = readString(data);
+        s.encoderName = readString(data);
+        if (data.remaining() >= NEW_DISPLAY_LENGTH) {
+            s.newDisplayWidth = data.getShort() & 0xffff;
+            s.newDisplayHeight = data.getShort() & 0xffff;
+            s.newDisplayDpi = data.getShort() & 0xffff;
+        }
+        if (data.remaining() >= FLAGS_LENGTH) {
+            s.flags = data.get() & 0xff;
+        }
+        s.startApp = readString(data);
+        return s;
+    }
+
+    private static String readString(ByteBuffer data) {
+        if (data.remaining() < 4) {
+            return null;
+        }
+        int length = data.getInt();
+        if (length <= 0) {
+            return null;
+        }
+        byte[] bytes = new byte[length];
+        data.get(bytes);
+        String value = new String(bytes, StandardCharsets.UTF_8);
+        return value.isEmpty() || "-".equals(value) ? null : value;
+    }
+
+    public byte[] toByteArray() {
+        byte[] codecOptionsBytes = codecOptions == null ? new byte[0] : codecOptions.getBytes(StandardCharsets.UTF_8);
+        byte[] encoderNameBytes = encoderName == null ? new byte[0] : encoderName.getBytes(StandardCharsets.UTF_8);
+        byte[] startAppBytes = startApp == null ? new byte[0] : startApp.getBytes(StandardCharsets.UTF_8);
+        ByteBuffer buffer = ByteBuffer.allocate(BASE_LENGTH + codecOptionsBytes.length + encoderNameBytes.length + NEW_DISPLAY_LENGTH
+                + FLAGS_LENGTH + 4 + startAppBytes.length);
+        buffer.putInt(bitRate);
+        buffer.putInt(maxFps);
+        buffer.put(iFrameInterval);
+        buffer.putShort((short) boundsWidth);
+        buffer.putShort((short) boundsHeight);
+        Rect c = crop != null ? crop : new Rect();
+        buffer.putShort((short) c.left);
+        buffer.putShort((short) c.top);
+        buffer.putShort((short) c.right);
+        buffer.putShort((short) c.bottom);
+        buffer.put((byte) (sendFrameMeta ? 1 : 0));
+        buffer.put((byte) lockedVideoOrientation);
+        buffer.putInt(displayId);
+        buffer.putInt(codecOptionsBytes.length);
+        buffer.put(codecOptionsBytes);
+        buffer.putInt(encoderNameBytes.length);
+        buffer.put(encoderNameBytes);
+        buffer.putShort((short) newDisplayWidth);
+        buffer.putShort((short) newDisplayHeight);
+        buffer.putShort((short) newDisplayDpi);
+        buffer.put((byte) flags);
+        buffer.putInt(startAppBytes.length);
+        buffer.put(startAppBytes);
+        return buffer.array();
+    }
+
+    public boolean isNewDisplay() {
+        return displayId == Device.DISPLAY_ID_NONE;
+    }
+
+    public int getDisplayId() {
+        return displayId;
+    }
+
+    /**
+     * Copy with another display id: once created, a new virtual display is identified by its own display id.
+     */
+    public WsVideoSettings withDisplayId(int newDisplayId) {
+        WsVideoSettings copy = fromBuffer(ByteBuffer.wrap(toByteArray()));
+        copy.displayId = newDisplayId;
+        return copy;
+    }
+
+    public boolean hasNewDisplayParams() {
+        return newDisplayWidth != 0 || newDisplayHeight != 0 || newDisplayDpi != 0;
+    }
+
+    public int getNewDisplayWidth() {
+        return newDisplayWidth;
+    }
+
+    public int getNewDisplayHeight() {
+        return newDisplayHeight;
+    }
+
+    public int getNewDisplayDpi() {
+        return newDisplayDpi;
+    }
+
+    /**
+     * The package of the app to start once the new virtual display is created (also reported to the clients, so that they can find
+     * the display running an app).
+     */
+    public String getStartApp() {
+        return startApp;
+    }
+
+    public boolean isKeepActive() {
+        return (flags & FLAG_KEEP_ACTIVE) != 0;
+    }
+
+    /**
+     * A flex display (a new virtual display only) is resized to the size of the client window.
+     */
+    public boolean isFlexDisplay() {
+        return (flags & FLAG_FLEX_DISPLAY) != 0;
+    }
+
+    public int getBitRate() {
+        return bitRate;
+    }
+
+    public int getMaxFps() {
+        return maxFps;
+    }
+
+    public String getEncoderName() {
+        return encoderName;
+    }
+
+    /**
+     * Codec options in the scrcpy syntax, including the I-frame interval.
+     */
+    public String getFullCodecOptions() {
+        String iFrame = "i-frame-interval:int=" + (iFrameInterval > 0 ? iFrameInterval : 10);
+        return codecOptions == null ? iFrame : iFrame + "," + codecOptions;
+    }
+
+    /**
+     * Convert the bounding box requested by the client to the scrcpy "max size" (the maximum of width and height).
+     *
+     * @param displaySize the (rotated) size of the captured display
+     * @return the max size, 0 for no limit
+     */
+    public int computeMaxSize(Size displaySize) {
+        if (boundsWidth == 0 || boundsHeight == 0 || displaySize == null) {
+            return 0;
+        }
+        int w = displaySize.getWidth();
+        int h = displaySize.getHeight();
+        if (boundsWidth >= w && boundsHeight >= h) {
+            return 0;
+        }
+        double scale = Math.min((double) boundsWidth / w, (double) boundsHeight / h);
+        return (int) (Math.max(w, h) * scale);
+    }
+
+    /**
+     * Return the value for the scrcpy "capture_orientation" option, or null if the orientation is not locked.
+     */
+    public String getCaptureOrientation() {
+        switch (lockedVideoOrientation) {
+            case 0:
+                return "@0";
+            case 1:
+                return "@90";
+            case 2:
+                return "@180";
+            case 3:
+                return "@270";
+            case -2:
+                return "@";
+            default:
+                return null;
+        }
+    }
+
+    /**
+     * Return the value for the scrcpy "crop" option ("width:height:x:y"), or null.
+     */
+    public String getCrop() {
+        if (crop == null) {
+            return null;
+        }
+        return crop.width() + ":" + crop.height() + ":" + crop.left + ":" + crop.top;
+    }
+
+    /**
+     * Whether the capture must be recreated to apply these settings (as opposed to only reconfiguring the encoder).
+     */
+    public boolean requiresNewCapture(WsVideoSettings o) {
+        return displayId != o.displayId || lockedVideoOrientation != o.lockedVideoOrientation || !Objects.equals(crop, o.crop)
+                || newDisplayWidth != o.newDisplayWidth || newDisplayHeight != o.newDisplayHeight || newDisplayDpi != o.newDisplayDpi
+                || flags != o.flags;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (!(o instanceof WsVideoSettings)) {
+            return false;
+        }
+        return Arrays.equals(toByteArray(), ((WsVideoSettings) o).toByteArray());
+    }
+
+    @Override
+    public int hashCode() {
+        return Arrays.hashCode(toByteArray());
+    }
+
+    @Override
+    public String toString() {
+        return "WsVideoSettings{bitRate=" + bitRate + ", maxFps=" + maxFps + ", iFrameInterval=" + iFrameInterval + ", bounds=" + boundsWidth
+                + "x" + boundsHeight + ", crop=" + getCrop() + ", lockedVideoOrientation=" + lockedVideoOrientation + ", displayId=" + displayId
+                + ", codecOptions=" + codecOptions + ", encoderName=" + encoderName + ", newDisplay=" + newDisplayWidth + "x" + newDisplayHeight
+                + "/" + newDisplayDpi + ", flags=" + flags + ", startApp=" + startApp + "}";
+    }
+}
