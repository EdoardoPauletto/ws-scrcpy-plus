--- /dev/null
+++ b/server/src/main/java/com/genymobile/scrcpy/ws/WsControlChannel.java
@@ -0,0 +1,72 @@
+package com.genymobile.scrcpy.ws;
+
+import com.genymobile.scrcpy.control.ControlChannel;
+import com.genymobile.scrcpy.control.ControlMessage;
+import com.genymobile.scrcpy.control.ControlMessageReader;
+import com.genymobile.scrcpy.control.DeviceMessage;
+import com.genymobile.scrcpy.control.DeviceMessageWriter;
+import com.genymobile.scrcpy.util.Ln;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.nio.ByteBuffer;
+import java.util.concurrent.BlockingQueue;
+import java.util.concurrent.LinkedBlockingQueue;
+
+/**
+ * Control channel fed by WebSocket messages: each WebSocket message holds exactly one control message.
+ */
+public final class WsControlChannel extends ControlChannel {
+
+    public interface Output {
+        void sendDeviceMessage(ByteBuffer message);
+    }
+
+    private static final byte[] CLOSED = new byte[0];
+
+    private final BlockingQueue<byte[]> queue = new LinkedBlockingQueue<>();
+    private final Output output;
+
+    public WsControlChannel(Output output) {
+        this.output = output;
+    }
+
+    public void push(byte[] message) {
+        queue.offer(message);
+    }
+
+    public void close() {
+        queue.offer(CLOSED);
+    }
+
+    @Override
+    public ControlMessage recv() throws IOException {
+        while (true) {
+            byte[] message;
+            try {
+                message = queue.take();
+            } catch (InterruptedException e) {
+                throw new InterruptedIOException();
+            }
+            if (message == CLOSED) {
+                throw new IOException("Control channel closed");
+            }
+            // Parse each message independently, so that a malformed message cannot desynchronize the following ones
+            try {
+                return new ControlMessageReader(new ByteArrayInputStream(message)).read();
+            } catch (IOException e) {
+                Ln.w("Invalid control message (type " + (message.length > 0 ? message[0] : -1) + "): " + e);
+            }
+        }
+    }
+
+    @Override
+    public void send(DeviceMessage msg) throws IOException {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        bytes.write(WsServer.MAGIC_BYTES_MESSAGE);
+        new DeviceMessageWriter(bytes).write(msg);
+        output.sendDeviceMessage(ByteBuffer.wrap(bytes.toByteArray()));
+    }
+}
