diff --git a/server/src/main/java/com/genymobile/scrcpy/ws/WsAudio.java b/server/src/main/java/com/genymobile/scrcpy/ws/WsAudio.java
new file mode 100644
index 0000000..48f3ec7
--- /dev/null
+++ b/server/src/main/java/com/genymobile/scrcpy/ws/WsAudio.java
@@ -0,0 +1,108 @@
+package com.genymobile.scrcpy.ws;
+
+import com.genymobile.scrcpy.AsyncProcessor;
+import com.genymobile.scrcpy.audio.AudioCapture;
+import com.genymobile.scrcpy.audio.AudioCodec;
+import com.genymobile.scrcpy.audio.AudioDirectCapture;
+import com.genymobile.scrcpy.audio.AudioPlaybackCapture;
+import com.genymobile.scrcpy.audio.AudioRawRecorder;
+import com.genymobile.scrcpy.audio.AudioSource;
+import com.genymobile.scrcpy.device.Streamer;
+import com.genymobile.scrcpy.util.Ln;
+
+import org.java_websocket.WebSocket;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArraySet;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * The device audio output, captured once and sent to all the clients which enabled the audio.
+ * <p>
+ * Packets are raw PCM (48 kHz, stereo, signed 16-bit little-endian), prefixed by {@link #MAGIC_BYTES_AUDIO}. A prefix alone (without
+ * samples) means that the audio could not be captured.
+ */
+public final class WsAudio implements Streamer.Sink {
+
+    static final byte[] MAGIC_BYTES_AUDIO = "scrcpy_audio__".getBytes(StandardCharsets.UTF_8);
+
+    // Read by the recorder thread without locking (it may be joined by start() while holding the monitor)
+    private final Set<WebSocket> sockets = new CopyOnWriteArraySet<>();
+    // Not guarded by the monitor: the recorder thread clears it on termination (while start() may be joining it)
+    private final AtomicReference<AsyncProcessor> recorder = new AtomicReference<>();
+    private AsyncProcessor stoppedRecorder;
+
+    /**
+     * @param duplicate keep playing the audio on the device (Android 13+); only applied if the capture is not already running
+     */
+    public synchronized void join(WebSocket webSocket, boolean duplicate) {
+        sockets.add(webSocket);
+        if (recorder.get() == null) {
+            start(duplicate);
+        }
+    }
+
+    public synchronized void leave(WebSocket webSocket) {
+        if (sockets.remove(webSocket) && sockets.isEmpty()) {
+            AsyncProcessor running = recorder.getAndSet(null);
+            if (running != null) {
+                Ln.d("Last audio client left");
+                running.stop();
+                stoppedRecorder = running;
+            }
+        }
+    }
+
+    private void start(boolean duplicate) {
+        if (stoppedRecorder != null) {
+            // Only one capture of the audio output at a time
+            try {
+                stoppedRecorder.join();
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            stoppedRecorder = null;
+        }
+        AudioCapture capture = duplicate ? new AudioPlaybackCapture(true) : new AudioDirectCapture(AudioSource.OUTPUT);
+        Streamer streamer = new Streamer(this, AudioCodec.RAW, false, false);
+        AudioRawRecorder audioRecorder = new AudioRawRecorder(capture, streamer);
+        recorder.set(audioRecorder);
+        audioRecorder.start((fatalError) -> onTerminated(audioRecorder));
+    }
+
+    private void onTerminated(AsyncProcessor terminated) {
+        if (recorder.compareAndSet(terminated, null)) {
+            Ln.w("Audio capture stopped");
+        }
+    }
+
+    private void broadcast(ByteBuffer samples) {
+        ByteBuffer message = ByteBuffer.allocate(MAGIC_BYTES_AUDIO.length + samples.remaining());
+        message.put(MAGIC_BYTES_AUDIO);
+        message.put(samples);
+        message.flip();
+        for (WebSocket webSocket : sockets) {
+            if (webSocket.isOpen()) {
+                webSocket.send(message.duplicate());
+            }
+        }
+    }
+
+    @Override
+    public void write(ByteBuffer buffer) {
+        broadcast(buffer);
+    }
+
+    @Override
+    public void onSessionStarted(int width, int height, boolean isClientResize) {
+        // video only
+    }
+
+    @Override
+    public void onStreamDisabled(boolean error) {
+        Ln.w("Audio capture is not available");
+        broadcast(ByteBuffer.allocate(0));
+    }
+}
diff --git a/server/src/main/java/com/genymobile/scrcpy/ws/WsControlChannel.java b/server/src/main/java/com/genymobile/scrcpy/ws/WsControlChannel.java
